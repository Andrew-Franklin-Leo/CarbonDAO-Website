{
  "extends": "@tsconfig/docusaurus/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@site/*": ["./*"],
      "@theme/*": ["./src/theme/*"]
    },
    "types": ["node"],
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": [
    "src/**/*",
    "docusaurus.config.js",
    "sidebars.js",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "scripts/templates"
  ]
}