# AI Service Configuration

# Deepseek R1
DEEPSEEK_ENDPOINT="https://api.deepseek.com/v1"
DEEPSEEK_API_KEY="your_deepseek_api_key"

# Llama 3.3
LLAMA_ENDPOINT="https://api.llama.ai/v1"
LLAMA_API_KEY="your_llama_api_key"

# Gemini Flash 2.0
GEMINI_ENDPOINT="https://api.gemini.com/v1"
GEMINI_API_KEY="your_gemini_api_key"

# OpenRouter APIs
OPENROUTER_ENDPOINT="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY="your_openrouter_api_key"

# Azure OpenAI (Fallback)
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY="your_azure_openai_api_key"

# Blog Generation Settings
BLOG_GENERATION_INTERVAL="0 0 * * *" # Daily at midnight
BLOG_CACHE_DURATION=86400 # 24 hours in seconds
MAX_RETRIES=3
RATE_LIMIT_DELAY=5000 # 5 seconds between requests